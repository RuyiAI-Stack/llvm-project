# RUN: llc -mtriple=riscv64 -mattr=+zames \
# RUN:   -run-pass=riscv-expand-pseudo-pre-emit -o - %s | FileCheck %s

# Late expansion must derive the msetcfg selector from the physical matrix
# register on the pseudo operand: tr0-tr3 -> 0-3, acc0-acc3 -> 4-7. It must
# also preserve the machine operand order C, B, A on the final mmacc.
# These relationships cannot be checked in the .ll tests because register
# allocation picks the registers there.
# Matrix operands are live on entry to this post-RA pass fixture.

--- |
  define void @zames_mir_cfg() { ret void }
...
---
name:            zames_mir_cfg
body:             |
  bb.0:
    liveins: $xsai_zames_acc2, $xsai_zames_tr3, $xsai_zames_tr1

    ; f16 x f16 -> f32 with C = acc2, B = tr3, A = tr1
    $x10 = ADDI $x0, 12
    $x11 = ADDI $x0, 9
    ; CHECK: XSAI_ZAMES_MSETCFG 6, {{[^:]*}}$x10{{$}}
    ; CHECK-NEXT: XSAI_ZAMES_MSETCFG 3, {{[^:]*}}$x11{{$}}
    ; CHECK-NEXT: XSAI_ZAMES_MSETCFG 1, {{[^:]*}}$x11{{$}}
    ; CHECK-NEXT: $xsai_zames_acc2 = XSAI_ZAMES_MMACC {{[^:]*}}$xsai_zames_acc2, {{[^:]*}}$xsai_zames_tr3, {{[^:]*}}$xsai_zames_tr1{{$}}
    $xsai_zames_acc2 = PSEUDO_XSAI_ZAMES_MMACC_F16_F32 $xsai_zames_acc2, $xsai_zames_tr3, $xsai_zames_tr1, $x10, $x11, $x11

    ; fp16 tile load into tr2
    $x12 = ADDI $x0, 9
    ; CHECK: XSAI_ZAMES_MSETCFG 2, {{[^:]*}}$x12{{$}}
    ; CHECK-NEXT: $xsai_zames_tr2 = XSAI_ZAMES_MLA
    $xsai_zames_tr2 = PSEUDO_XSAI_ZAMES_MLA_A_F16 $x10, $x11, $x12

    ; bf16 tile store from tr3
    $x13 = ADDI $x0, 10
    ; CHECK: XSAI_ZAMES_MSETCFG 3, {{[^:]*}}$x13{{$}}
    ; CHECK-NEXT: XSAI_ZAMES_MSA
    PSEUDO_XSAI_ZAMES_MSA_A_BF16 $xsai_zames_tr3, $x10, $x11, $x13

    ; mzero into an fp16 tile register
    $x14 = ADDI $x0, 9
    ; CHECK: XSAI_ZAMES_MSETCFG 1, {{[^:]*}}$x14{{$}}
    ; CHECK-NEXT: $xsai_zames_tr1 = XSAI_ZAMES_MZERO{{$}}
    $xsai_zames_tr1 = PSEUDO_XSAI_ZAMES_MZERO_T_F16 $x14

    ; mzero into accumulator acc2
    $x15 = ADDI $x0, 12
    ; CHECK: XSAI_ZAMES_MSETCFG 6, {{[^:]*}}$x15{{$}}
    ; CHECK-NEXT: $xsai_zames_acc2 = XSAI_ZAMES_MZERO{{$}}
    $xsai_zames_acc2 = PSEUDO_XSAI_ZAMES_MZERO_C_F32 $x15

    PseudoRET
...
